{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/stepcheck_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/stepcheck_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/stepcheck_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/stepcheck_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
